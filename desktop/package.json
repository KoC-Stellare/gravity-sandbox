{
  "name": "gravity-sandbox-desktop",
  "productName": "Gravity SandBox",
  "version": "1.2.0",
  "description": "First-person gravity and telekinesis sandbox.",
  "desktopName": "gravity-sandbox.desktop",
  "author": "Gravity SandBox",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/koc-stellare/gravity-sandbox.git"
  },
  "main": "main.js",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "start": "npm run vendor && electron .",
    "dist": "npm run vendor && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run vendor && electron-builder --dir --publish never",
    "dist:linux": "npm run vendor && electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@supabase/supabase-js": "2.45.4",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "app.gravitysandbox.desktop",
    "productName": "Gravity SandBox",
    "artifactName": "GravitySandBox-Windows.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "web",
        "filter": [
          "play.html",
          "manifest.webmanifest",
          "css/**",
          "js/**",
          "lib/**",
          "icons/**"
        ]
      },
      {
        "from": "vendor",
        "to": "web/vendor"
      }
    ],
    "icon": "../icons/icon-512.png",
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "GravitySandBox-Linux.${ext}",
      "synopsis": "First-person gravity and telekinesis sandbox",
      "syncDesktopName": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Gravity SandBox",
      "artifactName": "GravitySandBox-Setup.${ext}"
    }
  }
}
